/* unix_patch  old_file  patch_file  {-output_file path | -of path}
 *
 * Applies one unified-diff patch (the kind produced by
 *     diff -u  old_file  new_file  >patch_file )
 * to old_file, reconstructing new_file.  With -output_file (-of)
 * the result is written to that segment; otherwise it is printed
 * on standard output with ioa_.
 *
 * Supported subset:
 *   the --- / +++ header is skipped;
 *   each hunk header (two at-signs, old and new line ranges) is
 *     applied at the old line number it names;
 *   context (' ') and deletion ('-') lines are verified against
 *     old_file (a mismatch aborts with "Hunk n ...");
 *   a trailing No-newline-at-end-of-file marker is honoured;
 *   text outside any hunk is copied through unchanged.
 *
 * Not implemented (not needed for a clean single-file diff -u):
 *   fuzz/offset matching, reversed patches, multi-file patches,
 *   and ed/context (non-unified) formats.
 *
 * The result is built in a temporary segment first, so a failed
 * match never leaves a partial output file behind.
 *
 * NOTE ON LINE WIDTH: kept under 72 columns on purpose.  A source
 * line whose closing star-slash lands near an 80-column wrap can
 * be split on input, turning it into a runaway comment that eats
 * the following statement.  Keep new lines short and avoid
 * trailing comments out near column 80.
 */

/* Written 12 September 2026 by Claude Opus 4.8 at the direction of
 * Jim Lippard.  Minimal patcher for the output of
 *     diff -u oldfile newfile >changes.diff
 * for a single file.  Prints to the terminal unless -of is given.
 */

unix_patch:
   proc options (main);

   /* ---- hardcore gate entries ---- */
   dcl hcs_$initiate_count entry
      (char(*), char(*), char(*), fixed bin(24),
       fixed bin(2), ptr, fixed bin(35));
   dcl hcs_$make_seg entry
      (char(*), char(*), char(*), fixed bin(5),
       ptr, fixed bin(35));
   dcl hcs_$set_bc_seg       entry (ptr, fixed bin(24),
                                    fixed bin(35));
   dcl hcs_$truncate_seg     entry (ptr, fixed bin(24),
                                    fixed bin(35));
   dcl hcs_$terminate_noname entry (ptr, fixed bin(35));

   /* ---- command / utility entries ---- */
   dcl cu_$arg_count entry (fixed bin, fixed bin(35));
   dcl cu_$arg_ptr   entry (fixed bin, ptr, fixed bin(21),
                            fixed bin(35));
   dcl expand_pathname_$component entry
      (char(*), char(*), char(*), char(*), fixed bin(35));
   dcl archive_$get_component entry
      (ptr, fixed bin(24), char(*), ptr, fixed bin(24),
       fixed bin(35));
   dcl get_equal_name_ entry (char(*), char(*), char(*),
                              fixed bin(35));
   dcl com_err_               entry options (variable);
   dcl ioa_                   entry options (variable);
   dcl ioa_$nnl               entry options (variable);
   dcl get_temp_segments_     entry (char(*), (*) ptr,
                                     fixed bin(35));
   dcl release_temp_segments_ entry (char(*), (*) ptr,
                                     fixed bin(35));
   dcl command_query_         entry options (variable);
   dcl hcs_$delentry_file     entry (char(*), char(*),
                                     fixed bin(35));

   /* ---- error codes ---- */
   dcl error_table_$namedup   fixed bin (35) ext static;

   /* ---- builtins ---- */
   dcl (addr, byte, divide, index, length, null, rtrim,
        substr) builtin;

   /* ---- resolved paths ---- */
   dcl (old_dir, pat_dir, of_dir)    char (168);
   dcl (old_ent, pat_ent, of_ent)    char (32);
   dcl (old_comp, pat_comp, of_comp) char (32);
   dcl old_srcname                   char (32);
   dcl eq_name                       char (32);
   dcl old_show                      char (66) varying;

   /* ---- argument scanning ---- */
   dcl (nargs, i) fixed bin;
   dcl code       fixed bin (35);
   dcl argp       ptr;
   dcl argl       fixed bin (21);
   dcl arg_str    char (argl) based (argp);
   dcl (old_argp, pat_argp, of_argp) ptr;
   dcl (old_argl, pat_argl, of_argl) fixed bin (21);
   dcl (old_seen, pat_seen, have_of, temp_gotten) bit (1);

   /* ---- segments ---- */
   dcl (old_ptr, pat_ptr, out_ptr, tgt_ptr) ptr;
   dcl (old_data_ptr, pat_data_ptr)         ptr;
   dcl (old_len, pat_len, out_len)          fixed bin (24);
   dcl old_buf char (old_len) based (old_data_ptr);
   dcl pat_buf char (pat_len) based (pat_data_ptr);
   dcl out_buf char (OUT_MAX) based (out_ptr);
   dcl tgt_seg char (OUT_MAX) based (tgt_ptr);
   dcl temp_segs (1) ptr;

   /* ---- apply state ---- */
   dcl (cur_off, cur_line, hunk_no)          fixed bin (24);
   dcl (pat_off, pnext, pline_len, oldstart) fixed bin (24);
   dcl (ptxt_off, ptxt_len, kk)              fixed bin (24);
   dcl (otl, ofl)                            fixed bin (24);
   dcl onl                                   bit (1);
   dcl pm                                    char (1);
   dcl (in_hunk, scan_more)                  bit (1);
   dcl loose                                 bit (1);
   dcl HT                                    char (1);

   /* ---- constants ---- */
   dcl OUT_MAX fixed bin (24) int static options (constant)
                             init (1044480);
   dcl RW_ACCESS fixed bin (5) int static options (constant)
                             init (01010b);
   dcl DIGITS char (10) int static options (constant)
                             init ("0123456789");
   dcl USAGE char (48) int static options (constant)
      init ("Usage: unix_patch old_file patch_file {-of path}");
   dcl NL char (1);

   /* ------------------------------------------------------- */

   NL          = byte (10);
   HT          = byte (9);
   old_ptr     = null ();
   pat_ptr     = null ();
   temp_gotten = "0"b;
   old_seen    = "0"b;
   pat_seen    = "0"b;
   have_of     = "0"b;
   loose       = "0"b;

   /* ---- parse the command line ---- */
   call cu_$arg_count (nargs, code);
   if code ^= 0 then do;
      call com_err_ (code, "unix_patch", "^a", USAGE);
      go to cleanup;
   end;

   i = 1;
   do while (i <= nargs);
      call cu_$arg_ptr (i, argp, argl, code);
      if code ^= 0 then do;
         call com_err_ (code, "unix_patch",
            "Cannot access argument ^d.", i);
         go to cleanup;
      end;

      if substr (arg_str, 1, 1) = "-" then do;
         if arg_str = "-output_file" | arg_str = "-of"
         then do;
            if i >= nargs then do;
               call com_err_ (0, "unix_patch",
                  "No path after ^a.  ^a", arg_str, USAGE);
               go to cleanup;
            end;
            i = i + 1;
            call cu_$arg_ptr (i, of_argp, of_argl, code);
            have_of = "1"b;
         end;
         else if arg_str = "-ignore_whitespace"
               | arg_str = "-l" then loose = "1"b;
         else do;
            call com_err_ (0, "unix_patch",
               "Unknown control argument ^a.", arg_str);
            go to cleanup;
         end;
      end;
      else do;
         if ^old_seen then do;
            old_argp = argp;
            old_argl = argl;
            old_seen = "1"b;
         end;
         else if ^pat_seen then do;
            pat_argp = argp;
            pat_argl = argl;
            pat_seen = "1"b;
         end;
         else do;
            call com_err_ (0, "unix_patch",
               "Too many arguments.  ^a", USAGE);
            go to cleanup;
         end;
      end;

      i = i + 1;
   end;

   if ^old_seen | ^pat_seen then do;
      call com_err_ (0, "unix_patch", "^a", USAGE);
      go to cleanup;
   end;

   /* ---- resolve and open the old file ---- */
   call resolve_comp (old_argp, old_argl, "old-file",
                      old_dir, old_ent, old_comp);
   call open_input ("old file", old_dir, old_ent, old_comp,
                    old_data_ptr, old_len, old_ptr);

   /* the source name drives the equals convention below */
   if old_comp ^= "" then old_srcname = old_comp;
                     else old_srcname = old_ent;

   /* a readable name for messages: entry, or entry::component */
   if old_comp ^= "" then
      old_show = rtrim (old_ent) || "::" || rtrim (old_comp);
   else old_show = rtrim (old_ent);

   /* ---- resolve and open the patch file (equals allowed) ---- */
   call resolve_comp (pat_argp, pat_argl, "patch-file",
                      pat_dir, pat_ent, pat_comp);
   if index (pat_ent, "=") > 0 then do;
      call get_equal_name_ (old_srcname, pat_ent, eq_name,
                            code);
      if code ^= 0 then do;
         call com_err_ (code, "unix_patch",
            "Cannot apply the equal name ^a to ^a.",
            rtrim (pat_ent), rtrim (old_srcname));
         go to cleanup;
      end;
      pat_ent = eq_name;
   end;
   call open_input ("patch file", pat_dir, pat_ent, pat_comp,
                    pat_data_ptr, pat_len, pat_ptr);

   /* ---- resolve the output path if -of was given ---- */
   if have_of then do;
      call resolve_comp (of_argp, of_argl, "output-file",
                         of_dir, of_ent, of_comp);
      if of_comp ^= "" then do;
         call com_err_ (0, "unix_patch",
            "Output to an archive component is not supported.");
         go to cleanup;
      end;
      if index (of_ent, "=") > 0 then do;
         call get_equal_name_ (old_srcname, of_ent, eq_name,
                               code);
         if code ^= 0 then do;
            call com_err_ (code, "unix_patch",
               "Cannot apply the equal name ^a to ^a.",
               rtrim (of_ent), rtrim (old_srcname));
            go to cleanup;
         end;
         of_ent = eq_name;
      end;
   end;

   /* ---- scratch segment for the result ---- */
   call get_temp_segments_ ("unix_patch", temp_segs, code);
   if code ^= 0 then do;
      call com_err_ (code, "unix_patch",
         "Could not obtain a temporary segment.");
      go to cleanup;
   end;
   temp_gotten = "1"b;
   out_ptr = temp_segs (1);
   out_len = 0;

   /* ---- walk the patch, hunk by hunk ---- */
   /* cur_off/cur_line = next unconsumed old line (1-based) */
   cur_off   = 1;
   cur_line  = 1;
   hunk_no   = 0;
   pat_off   = 1;
   in_hunk   = "0"b;
   scan_more = "1"b;

   scan_patch:
   do while (pat_off <= pat_len & scan_more);

      /* isolate the current patch line (no newline) */
      kk = index (substr (pat_buf, pat_off), NL);
      if kk = 0 then do;
         pline_len = pat_len - pat_off + 1;
         pnext     = pat_len + 1;
      end;
      else do;
         pline_len = kk - 1;
         pnext     = pat_off + kk;
      end;

      if pline_len >= 2
         & substr (pat_buf, pat_off, 2) = "@@"
      then do;
         /* hunk header */
         hunk_no = hunk_no + 1;
         call parse_oldstart (pat_off, pline_len, oldstart);
         call advance_old_to (oldstart);
         in_hunk = "1"b;
      end;

      else if in_hunk then do;
         /* hunk body */
         if pline_len = 0
            then pm = " ";
            else pm = substr (pat_buf, pat_off, 1);

         if pline_len >= 1 then do;
            ptxt_off = pat_off + 1;
            ptxt_len = pline_len - 1;
         end;
         else do;
            ptxt_off = pat_off;
            ptxt_len = 0;
         end;

         if pm = " " then do;
            /* context: verify, then copy the old line */
            call cur_old_extent (otl, ofl, onl);
            if ofl = 0 then call short_old;
            call verify (otl, ptxt_off, ptxt_len);
            call emit (substr (old_buf, cur_off, ofl));
            cur_off  = cur_off + ofl;
            cur_line = cur_line + 1;
         end;

         else if pm = "-" then do;
            /* deletion: verify, then drop the old line */
            call cur_old_extent (otl, ofl, onl);
            if ofl = 0 then call short_old;
            call verify (otl, ptxt_off, ptxt_len);
            cur_off  = cur_off + ofl;
            cur_line = cur_line + 1;
         end;

         else if pm = "+" then do;
            /* addition: take the text from the patch */
            if ptxt_len > 0 then
               call emit (substr (pat_buf, ptxt_off,
                                  ptxt_len));
            /* a following "\" marker means no newline */
            if peek_char (pnext) ^= "\" then call emit (NL);
         end;

         else if pm = "\" then ;   /* No-newline: see above */

         else scan_more = "0"b;    /* ends this file's patch */
      end;

      /* else: preamble before the first hunk -- skipped */

      pat_off = pnext;
   end scan_patch;

   /* A patch with no hunk header applies nothing.  Rather than
    * deliver a misleading identity copy, fail as Unix patch does:
    * report it and write no output.  (On Multics the usual cause
    * is the two-at-sign header line being eaten on input, since
    * the at-sign is the line-kill character.)
    */
   if hunk_no = 0 then do;
      call com_err_ (0, "unix_patch",
         "No hunks found in ^a; nothing applied and no"
         || " output written.  A hunk header begins with"
         || " two at-signs -- check that the patch"
         || " reached Multics intact.",
         rtrim (pat_ent));
      go to cleanup;
   end;

   /* copy any old text following the last hunk */
   call copy_rest_old;

   /* deliver the result */
   if have_of then call flush_to_file;
              else call flush_to_terminal;

cleanup:
   if temp_gotten then
      call release_temp_segments_ ("unix_patch", temp_segs,
                                   code);
   if pat_ptr ^= null () then
      call hcs_$terminate_noname (pat_ptr, code);
   if old_ptr ^= null () then
      call hcs_$terminate_noname (old_ptr, code);
   return;


/* ---- Split an argument into directory, entry and (archive)
 *      component, accepting the archive "::" syntax that
 *      expand_path_ rejects.  Star names are not yet handled.
 */
resolve_comp:
   proc (ap, al, what, rdir, rent, rcomp);
   dcl ap    ptr;
   dcl al    fixed bin (21);
   dcl what  char (*);
   dcl rdir  char (*);
   dcl rent  char (*);
   dcl rcomp char (*);
   dcl astr  char (al) based (ap);
   dcl c     fixed bin (35);

   call expand_pathname_$component (astr, rdir, rent, rcomp, c);
   if c ^= 0 then do;
      call com_err_ (c, "unix_patch",
         "Cannot resolve the ^a path.", what);
      go to cleanup;
   end;
   if index (rent, "*") > 0 | index (rcomp, "*") > 0 then do;
      call com_err_ (0, "unix_patch",
         "Star names are not yet supported (^a).",
         rtrim (rent));
      go to cleanup;
   end;
   end resolve_comp;


/* ---- Initiate a resolved path and hand back a pointer and
 *      character count for its data.  For an archive component
 *      these describe the component inside the archive; SPTR is
 *      always the initiated segment, for the caller to end.
 */
open_input:
   proc (what, rdir, rent, rcomp, rptr, rlen, sptr);
   dcl what  char (*);
   dcl rdir  char (*);
   dcl rent  char (*);
   dcl rcomp char (*);
   dcl rptr  ptr;
   dcl rlen  fixed bin (24);
   dcl sptr  ptr;
   dcl (bc, cbc) fixed bin (24);
   dcl cptr  ptr;
   dcl c     fixed bin (35);

   rptr = null ();
   rlen = 0;
   call hcs_$initiate_count (rdir, rent, "", bc, 0, sptr, c);
   if sptr = null () then do;
      call com_err_ (c, "unix_patch",
         "Could not initiate ^a ^a>^a",
         what, rtrim (rdir), rtrim (rent));
      go to cleanup;
   end;
   if rcomp = "" then do;
      rptr = sptr;
      rlen = divide (bc, 9, 24, 0);
      return;
   end;
   call archive_$get_component (sptr, bc, (rcomp), cptr, cbc,
                                c);
   if c ^= 0 then do;
      call com_err_ (c, "unix_patch",
         "Could not find component ^a in ^a>^a",
         rtrim (rcomp), rtrim (rdir), rtrim (rent));
      go to cleanup;
   end;
   rptr = cptr;
   rlen = divide (cbc, 9, 24, 0);
   end open_input;


/* ---- Append a string to the accumulation buffer. ---- */
emit:
   proc (str);
   dcl str char (*);
   dcl m   fixed bin (24);

   m = length (str);
   if m <= 0 then return;
   if out_len + m > OUT_MAX then do;
      call com_err_ (0, "unix_patch",
         "Patched output exceeds one segment (^d chars).",
         OUT_MAX);
      go to cleanup;
   end;
   substr (out_buf, out_len + 1, m) = substr (str, 1, m);
   out_len = out_len + m;
   end emit;


/* ---- Describe the old line beginning at cur_off. ----
 *   tl = text length (no newline)
 *   fl = full length (with newline); fl = 0 means no line
 *   hn = "1"b if the line carries a trailing newline
 */
cur_old_extent:
   proc (tl, fl, hn);
   dcl (tl, fl) fixed bin (24);
   dcl hn       bit (1);
   dcl k        fixed bin (24);

   if cur_off > old_len then do;
      tl = 0;
      fl = 0;
      hn = "0"b;
      return;
   end;
   k = index (substr (old_buf, cur_off), NL);
   if k = 0 then do;
      fl = old_len - cur_off + 1;
      tl = fl;
      hn = "0"b;
   end;
   else do;
      fl = k;
      tl = k - 1;
      hn = "1"b;
   end;
   end cur_old_extent;


/* ---- Copy old lines until cur_line reaches target. ---- */
advance_old_to:
   proc (target);
   dcl target   fixed bin (24);
   dcl (tl, fl) fixed bin (24);
   dcl hn       bit (1);

   do while (cur_line < target);
      call cur_old_extent (tl, fl, hn);
      if fl = 0 then do;
         call com_err_ (0, "unix_patch",
            "Hunk ^d begins past the end of ^a.",
            hunk_no, old_show);
         go to cleanup;
      end;
      call emit (substr (old_buf, cur_off, fl));
      cur_off  = cur_off + fl;
      cur_line = cur_line + 1;
   end;
   end advance_old_to;


/* ---- Copy every remaining old line to the output. ---- */
copy_rest_old:
   proc;
   dcl (tl, fl) fixed bin (24);
   dcl hn       bit (1);

   do while (cur_off <= old_len);
      call cur_old_extent (tl, fl, hn);
      call emit (substr (old_buf, cur_off, fl));
      cur_off  = cur_off + fl;
      cur_line = cur_line + 1;
   end;
   end copy_rest_old;


/* ---- Verify the current old line against a patch line. ---- */
verify:
   proc (old_text_len, ptext_off, ptext_len);
   dcl (old_text_len, ptext_off, ptext_len) fixed bin (24);

   if loose then do;
      if ws_match (cur_off, old_text_len, ptext_off, ptext_len)
         then return;
      go to mismatch;
   end;
   if old_text_len ^= ptext_len then go to mismatch;
   if old_text_len > 0 then
      if substr (old_buf, cur_off, old_text_len)
         ^= substr (pat_buf, ptext_off, ptext_len)
      then go to mismatch;
   return;

mismatch:
   call com_err_ (0, "unix_patch",
      "Hunk ^d does not match ^a at line ^d.",
      hunk_no, old_show, cur_line);
   call ioa_ ("patch wants (^d):  ^a",
      ptext_len, substr (pat_buf, ptext_off, ptext_len));
   if old_text_len > 0 then
      call ioa_ ("old file has (^d):  ^a",
         old_text_len, substr (old_buf, cur_off, old_text_len));
   else call ioa_ ("old file has (0):");
   go to cleanup;
   end verify;


/* ---- Is the character at OFF in the given buffer a blank
 *      (space or tab)?
 */
is_blank:
   proc (c) returns (bit (1));
   dcl c char (1);
   if c = " " | c = HT then return ("1"b);
   return ("0"b);
   end is_blank;


/* ---- Compare an old line against a patch line, ignoring how
 *      runs of whitespace are written (for -ignore_whitespace).
 *      Any run of blanks matches any other run of blanks; a
 *      non-blank must match a non-blank exactly.
 */
ws_match:
   proc (oo, ol2, po, pl2) returns (bit (1));
   dcl (oo, ol2, po, pl2) fixed bin (24);
   dcl (i, j, ie, je)     fixed bin (24);
   dcl skipping           bit (1);

   i = oo;  ie = oo + ol2;
   j = po;  je = po + pl2;

   do while ("1"b);
      if i >= ie then do;
         if j >= je then return ("1"b);   /* both used up: match */
         return ("0"b);
      end;
      if j >= je then return ("0"b);

      if is_blank (substr (old_buf, i, 1)) then do;
         if ^is_blank (substr (pat_buf, j, 1)) then return ("0"b);
         /* consume the whole blank run on each side */
         skipping = "1"b;
         do while (skipping);
            if i >= ie then skipping = "0"b;
            else if ^is_blank (substr (old_buf, i, 1))
                 then skipping = "0"b;
            else i = i + 1;
         end;
         skipping = "1"b;
         do while (skipping);
            if j >= je then skipping = "0"b;
            else if ^is_blank (substr (pat_buf, j, 1))
                 then skipping = "0"b;
            else j = j + 1;
         end;
      end;
      else do;
         if is_blank (substr (pat_buf, j, 1)) then return ("0"b);
         if substr (old_buf, i, 1) ^= substr (pat_buf, j, 1)
            then return ("0"b);
         i = i + 1;
         j = j + 1;
      end;
   end;
   end ws_match;


/* ---- Report an old file that ran out mid-hunk. ---- */
short_old:
   proc;
   call com_err_ (0, "unix_patch",
      "Hunk ^d runs past the end of ^a at line ^d.",
      hunk_no, old_show, cur_line);
   go to cleanup;
   end short_old;


/* ---- First character of the patch line at OFF (blank if
 *      there is no such line).  Spots a following No-newline
 *      marker.
 */
peek_char:
   proc (off) returns (char (1));
   dcl off fixed bin (24);
   if off > pat_len then return (" ");
   return (substr (pat_buf, off, 1));
   end peek_char;


/* ---- Pull the old start line number from a hunk header:
 *      two at-signs, space, minus, A, comma, B, ...
 */
parse_oldstart:
   proc (loff, llen, val);
   dcl (loff, llen) fixed bin (24);
   dcl val          fixed bin (24);
   dcl (j, d)       fixed bin (24);
   dcl c            char (1);
   dcl scanning     bit (1);

   /* the minus that introduces the old-side range */
   j = index (substr (pat_buf, loff, llen), "-");
   if j = 0 then do;
      val = 0;
      return;
   end;
   j   = loff + j;          /* first digit after the minus */
   val = 0;
   scanning = "1"b;
   do while (j <= loff + llen - 1 & scanning);
      c = substr (pat_buf, j, 1);
      d = index (DIGITS, c);
      if d = 0 then scanning = "0"b;
      else do;
         val = val * 10 + (d - 1);
         j   = j + 1;
      end;
   end;
   end parse_oldstart;


/* ---- Write the result to the -output_file segment.  If the
 *      segment already exists, ask before replacing it, the way
 *      copy and the other commands do.
 */
flush_to_file:
   proc;
   dcl c2 fixed bin (35);
   dcl answer char (8) varying;
   dcl 1 qi aligned,
         2 version                  fixed bin,
         2 yes_or_no_sw             bit (1) unaligned,
         2 suppress_name_sw         bit (1) unaligned,
         2 cp_escape_control        bit (2) unaligned,
         2 suppress_spacing         bit (1) unaligned,
         2 literal_sw               bit (1) unaligned,
         2 prompt_after_explanation bit (1) unaligned,
         2 mbz                      bit (29) unaligned,
         2 status_code              fixed bin (35),
         2 query_code               fixed bin (35);

   call hcs_$make_seg (of_dir, of_ent, "", RW_ACCESS,
                       tgt_ptr, c2);
   if tgt_ptr = null () then do;
      call com_err_ (c2, "unix_patch",
         "Could not create output file ^a>^a",
         rtrim (of_dir), rtrim (of_ent));
      go to cleanup;
   end;

   if c2 = error_table_$namedup then do;
      qi.version                  = 5;
      qi.yes_or_no_sw             = "1"b;
      qi.suppress_name_sw         = "0"b;
      qi.cp_escape_control        = "00"b;
      qi.suppress_spacing         = "0"b;
      qi.literal_sw               = "0"b;
      qi.prompt_after_explanation = "0"b;
      qi.mbz                      = "0"b;
      qi.status_code              = error_table_$namedup;
      qi.query_code               = 0;
      call command_query_ (addr (qi), answer, "unix_patch",
         "Do you want to delete the old segment ^a>^a?",
         rtrim (of_dir), rtrim (of_ent));
      call hcs_$terminate_noname (tgt_ptr, c2);
      if answer = "no" then go to cleanup;
      call hcs_$delentry_file (of_dir, of_ent, c2);
      if c2 ^= 0 then do;
         call com_err_ (c2, "unix_patch",
            "Could not delete the old segment ^a>^a",
            rtrim (of_dir), rtrim (of_ent));
         go to cleanup;
      end;
      call hcs_$make_seg (of_dir, of_ent, "", RW_ACCESS,
                          tgt_ptr, c2);
      if tgt_ptr = null () then do;
         call com_err_ (c2, "unix_patch",
            "Could not create output file ^a>^a",
            rtrim (of_dir), rtrim (of_ent));
         go to cleanup;
      end;
   end;

   call hcs_$truncate_seg (tgt_ptr, 0, c2);   /* clean slate */
   if out_len > 0 then
      substr (tgt_seg, 1, out_len)
         = substr (out_buf, 1, out_len);
   call hcs_$set_bc_seg (tgt_ptr, out_len * 9, c2);
   call hcs_$truncate_seg (tgt_ptr,
                           divide (out_len + 3, 4, 24, 0), c2);
   call hcs_$terminate_noname (tgt_ptr, c2);
   end flush_to_file;


/* ---- Print the result on standard output, line by line. ---- */
flush_to_terminal:
   proc;
   dcl (o, k, seglen) fixed bin (24);

   o = 1;
   do while (o <= out_len);
      k = index (substr (out_buf, o, out_len - o + 1), NL);
      if k = 0 then seglen = out_len - o + 1;
               else seglen = k;
      call ioa_$nnl ("^a", substr (out_buf, o, seglen));
      o = o + seglen;
   end;
   end flush_to_terminal;

end unix_patch;
