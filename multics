#!/bin/ksh
#
# /etc/rc.d/multics

daemon="/usr/bin/tmux"
daemon_user="_multics"
daemon_flags="new-session -d -s multics '/usr/local/bin/dps8 /home/_multics/MR12.8_boot.ini'"

# Default timeout for start/stop. A clean Multics shutdown (logging out
# daemons, dropping to BCE, halting) takes far longer than rc.subr's 30 s
# default. multics_timeout in /etc/rc.conf.local still overrides this.
daemon_timeout="300"

. /etc/rc.d/rc.subr

# Match the simulator process itself, not the tmux server.
pexp=".*dps8 /home/_multics/MR12.8_boot.ini"

rc_reload=NO

rc_stop() {
	/usr/local/bin/shutdown_multics.pl
}

rc_cmd $1
